{
  "name": "ymind",
  "version": "1.0.0",
  "private": true,
  "description": "Independent local mind map editor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.ts tests/formats.test.ts tests/render.test.ts tests/richText.test.ts",
    "format": "prettier --write src electron tests",
    "format:check": "prettier --check src electron tests",
    "desktop": "install-electron && electron .",
    "dist:win": "install-electron && npm run build && electron-builder --win portable --x64",
    "test:desktop": "node tests/desktop.smoke.mjs"
  },
  "dependencies": {
    "docx": "9.10.0",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "lucide-react": "1.55.0",
    "mathjax-full": "3.2.2",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.58.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "local.ymind.editor",
    "productName": "YMIND",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": "true",
      "icon": "electron/icon.ico",
      "signExecutable": "false"
    },
    "portable": {
      "artifactName": "YMIND-${version}-Windows.exe"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "overrides": {
    "image-size": "2.0.4",
    "@xmldom/xmldom": "0.9.12",
    "uuid": "11.1.1",
    "global-agent": "4.1.3"
  },
  "author": "YMIND"
}
